<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>404 - Page Not Found | Placement Portal</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-light d-flex flex-column min-vh-100">

  <%- include('partials/navbar') %>

  <div class="container my-auto py-5 text-center">
    <div class="row justify-content-center">
      <div class="col-md-7 col-lg-5">
        <div class="portal-card shadow-sm p-4 p-md-5">
          <div class="stat-icon stat-icon-blue mx-auto mb-3" style="width: 56px; height: 56px; font-size: 1.5rem;">
            ?
          </div>
          <h1 class="display-5 fw-bold text-navy mb-2">404</h1>
          <h4 class="fw-bold mb-3">Page Not Found</h4>
          <p class="text-muted small mb-4">
            The placement drive, candidate record, or URL you are looking for might have been moved, closed, or does not exist.
          </p>
          <a href="/" class="btn btn-primary btn-sm px-4">Back to Safe Ground</a>
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
