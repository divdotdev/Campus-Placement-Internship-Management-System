<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Company Profile | Recruiter Portal' %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

  <%- include('../partials/navbar') %>

  <div class="portal-container">
    <% const activeTab = 'profile'; %>
    <%- include('../partials/recruiterSidebar', { activeTab }) %>

    <main class="portal-content">
      <%- include('../partials/alerts') %>

      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h2 class="h4 fw-bold mb-1">Company Profile</h2>
          <p class="text-muted small mb-0">Update organization overview, verified website, and recruitment contact points</p>
        </div>
      </div>

      <div class="portal-card">
        <div class="portal-card-body p-4">
          <form action="/recruiter/profile" method="POST">
            <div class="row g-3 mb-4">
              <div class="col-md-6">
                <label for="name" class="form-label">Company Name <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="name" name="name" required value="<%= company.name %>">
              </div>
              <div class="col-md-6">
                <label for="website" class="form-label">Official Website</label>
                <input type="url" class="form-control" id="website" name="website" placeholder="https://company.com" value="<%= company.website || '' %>">
              </div>
              <div class="col-md-6">
                <label for="contactPerson" class="form-label">Campus HR / Contact Person</label>
                <input type="text" class="form-control" id="contactPerson" name="contactPerson" value="<%= company.contactPerson || currentUser.name %>">
              </div>
              <div class="col-md-6">
                <label for="contactEmail" class="form-label">Contact / Communication Email</label>
                <input type="email" class="form-control" id="contactEmail" name="contactEmail" value="<%= company.contactEmail || currentUser.email %>">
              </div>
              <div class="col-md-12">
                <label for="logoUrl" class="form-label">Company Logo URL (optional)</label>
                <input type="url" class="form-control" id="logoUrl" name="logoUrl" placeholder="https://example.com/logo.png" value="<%= company.logoUrl || '' %>">
              </div>
              <div class="col-md-12">
                <label for="description" class="form-label">Company Description / Overview</label>
                <textarea class="form-control" id="description" name="description" rows="4"><%= company.description || '' %></textarea>
              </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
              <a href="/recruiter/dashboard" class="btn btn-outline-secondary">Cancel</a>
              <button type="submit" class="btn btn-primary px-4">Save Company Profile</button>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>

  <%- include('../partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
