<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Applicants | Recruiter Portal' %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

  <%- include('../partials/navbar') %>

  <div class="portal-container">
    <% const activeTab = 'drives'; %>
    <%- include('../partials/recruiterSidebar', { activeTab }) %>

    <main class="portal-content">
      <%- include('../partials/alerts') %>

      <div class="mb-3">
        <a href="/recruiter/drives" class="text-decoration-none small text-muted">&larr; Back to our drives</a>
      </div>

      <!-- Drive Header Banner -->
      <div class="portal-card mb-4">
        <div class="portal-card-body p-4">
          <div class="d-flex align-items-center gap-2 mb-1">
            <span class="drive-type-badge type-<%= drive.type.toLowerCase() %>"><%= drive.type %></span>
            <span class="badge <%= drive.status === 'Active' ? 'bg-success' : 'bg-secondary' %>"><%= drive.status %></span>
            <span class="small text-muted">&bull; Batch: <%= drive.graduationYear %></span>
          </div>
          <h3 class="fw-bold mb-1"><%= drive.role %></h3>
          <div class="small text-muted">
            Package / Stipend: <strong class="text-success"><%= drive.package || drive.stipend || 'Competitive' %></strong> &bull;
            Location: <strong><%= drive.location %></strong> (<%= drive.workMode %>) &bull;
            Min CGPA: <strong><%= drive.minCGPA %></strong> &bull;
            Branches: <strong><%= drive.eligibleBranches.join(', ') %></strong>
          </div>
        </div>
      </div>

      <!-- Stage Filter Pills -->
      <div class="btn-group btn-group-sm flex-wrap mb-3" role="group">
        <a href="/recruiter/drives/<%= drive._id %>/applicants" class="btn <%= activeStatus === 'All' ? 'btn-primary' : 'btn-outline-secondary' %>">All</a>
        <a href="/recruiter/drives/<%= drive._id %>/applicants?status=Applied" class="btn <%= activeStatus === 'Applied' ? 'btn-primary' : 'btn-outline-secondary' %>">Applied</a>
        <a href="/recruiter/drives/<%= drive._id %>/applicants?status=Shortlisted" class="btn <%= activeStatus === 'Shortlisted' ? 'btn-primary' : 'btn-outline-secondary' %>">Shortlisted</a>
        <a href="/recruiter/drives/<%= drive._id %>/applicants?status=Interviewed" class="btn <%= activeStatus === 'Interviewed' ? 'btn-primary' : 'btn-outline-secondary' %>">Interviewed</a>
        <a href="/recruiter/drives/<%= drive._id %>/applicants?status=Selected" class="btn <%= activeStatus === 'Selected' ? 'btn-primary' : 'btn-outline-secondary' %>">Selected</a>
        <a href="/recruiter/drives/<%= drive._id %>/applicants?status=Rejected" class="btn <%= activeStatus === 'Rejected' ? 'btn-primary' : 'btn-outline-secondary' %>">Rejected</a>
      </div>

      <!-- Applicants Table -->
      <div class="portal-card">
        <div class="table-responsive">
          <table class="table table-hover table-portal mb-0 align-middle">
            <thead>
              <tr>
                <th style="min-width: 180px;">Candidate</th>
                <th style="min-width: 85px;">Branch</th>
                <th style="min-width: 80px;">CGPA</th>
                <th style="min-width: 150px; max-width: 200px;">Skills</th>
                <th style="min-width: 110px;">Eligibility Check</th>
                <th style="min-width: 120px;">Status</th>
                <th class="text-end" style="min-width: 150px;">Update Round Stage</th>
              </tr>
            </thead>
            <tbody>
              <% if (applicants && applicants.length > 0) { %>
                <% applicants.forEach(app => { %>
                  <tr>
                    <td>
                      <div class="fw-bold text-truncate" style="max-width: 200px;"><%= app.student && app.student.user ? app.student.user.name : 'Candidate' %></div>
                      <div class="small text-muted font-monospace"><%= app.student ? app.student.rollNumber : '' %></div>
                      <div class="d-flex flex-wrap gap-2 mt-1">
                        <% if (app.student && app.student.resumeUrl) { %>
                          <a href="<%= app.student.resumeUrl %>" target="_blank" rel="noopener noreferrer" class="small text-primary text-decoration-none d-inline-flex align-items-center gap-1">
                            Resume &nearr;
                          </a>
                        <% } %>
                        <% if (app.student && app.student.linkedinUrl) { %>
                          <a href="<%= app.student.linkedinUrl %>" target="_blank" rel="noopener noreferrer" class="small text-muted text-decoration-none d-inline-flex align-items-center gap-1">
                            LinkedIn &nearr;
                          </a>
                        <% } %>
                        <% if (app.student && app.student.githubUrl) { %>
                          <a href="<%= app.student.githubUrl %>" target="_blank" rel="noopener noreferrer" class="small text-muted text-decoration-none d-inline-flex align-items-center gap-1">
                            GitHub &nearr;
                          </a>
                        <% } %>
                      </div>
                    </td>
                    <td><span class="badge bg-light text-dark border"><%= app.student ? app.student.branch : 'CSE' %></span></td>
                    <td class="fw-bold <%= app.student && app.student.cgpa >= drive.minCGPA ? 'text-success' : 'text-danger' %>">
                      <%= app.student ? app.student.cgpa : 'N/A' %>
                    </td>
                    <td style="max-width: 200px;">
                      <% if (app.student && app.student.skills && app.student.skills.length > 0) { %>
                        <div class="d-flex flex-wrap gap-1">
                          <% app.student.skills.slice(0, 3).forEach(sk => { %>
                            <span class="badge bg-light text-dark border small text-truncate" style="max-width: 95px;"><%= sk %></span>
                          <% }) %>
                        </div>
                      <% } else { %>
                        <span class="text-muted small">None</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (app.eligibility.eligible) { %>
                        <span class="badge-eligible">&check; Verified</span>
                      <% } else { %>
                        <span class="badge-ineligible" data-bs-toggle="tooltip" title="<%= app.eligibility.reasons.join(' | ') %>">
                          &cross; Ineligible
                        </span>
                      <% } %>
                    </td>
                    <td>
                      <span class="status-badge status-<%= app.status.toLowerCase() %>"><%= app.status %></span>
                    </td>
                    <td class="text-end">
                      <form action="/recruiter/drives/<%= drive._id %>/applicants/status" method="POST" class="d-inline-flex gap-1 align-items-center justify-content-end">
                        <input type="hidden" name="applicationId" value="<%= app._id %>">
                        <select name="newStatus" class="form-select form-select-sm" style="width: 135px;" onchange="this.form.submit()">
                          <option value="Applied" <%= app.status === 'Applied' ? 'selected' : '' %>>Applied</option>
                          <option value="Shortlisted" <%= app.status === 'Shortlisted' ? 'selected' : '' %>>Shortlisted</option>
                          <option value="Interviewed" <%= app.status === 'Interviewed' ? 'selected' : '' %>>Interviewed</option>
                          <option value="Selected" <%= app.status === 'Selected' ? 'selected' : '' %>>Selected</option>
                          <option value="Rejected" <%= app.status === 'Rejected' ? 'selected' : '' %>>Rejected</option>
                        </select>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="text-center py-5 text-muted">
                    No applicants registered under this category yet.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <%- include('../partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
