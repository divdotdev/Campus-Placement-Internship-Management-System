<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Sign In | Placement Portal' %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-light">

  <%- include('../partials/navbar') %>

  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-5">
        <%- include('../partials/alerts') %>

        <div class="portal-card shadow-sm">
          <div class="portal-card-body p-4 p-md-5">
            <div class="text-center mb-4">
              <img src="/images/logo.svg" alt="Placement Cell" width="48" height="48" class="mb-2">
              <h3 class="fw-bold mb-1">Welcome Back</h3>
              <p class="text-muted small">Sign in to your Campus Placement Portal account</p>
            </div>

            <!-- Role Selector Buttons for Ease of Use -->
            <div class="btn-group w-100 mb-4" role="group" aria-label="Role selector">
              <a href="/login?role=student" class="btn btn-sm <%= !role || role === 'student' ? 'btn-primary' : 'btn-outline-secondary' %>">Student</a>
              <a href="/login?role=admin" class="btn btn-sm <%= role === 'admin' ? 'btn-primary' : 'btn-outline-secondary' %>">Admin / Officer</a>
              <a href="/login?role=recruiter" class="btn btn-sm <%= role === 'recruiter' ? 'btn-primary' : 'btn-outline-secondary' %>">Recruiter</a>
            </div>

            <form action="/login" method="POST">
              <input type="hidden" name="role" id="roleInput" value="<%= role || '' %>">

              <div class="mb-3">
                <label for="email" class="form-label">Email Address</label>
                <input type="email" class="form-control" id="email" name="email" required placeholder="name@college.edu" autofocus>
              </div>

              <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <label for="password" class="form-label mb-0">Password</label>
                </div>
                <input type="password" class="form-control" id="password" name="password" required placeholder="Enter password">
              </div>

              <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Sign In to Dashboard</button>
            </form>

            <div class="mt-4 pt-3 border-top text-center small text-muted">
              Don't have an account yet?<br>
              <a href="/register/student" class="text-primary fw-semibold text-decoration-none">Student Registration</a> &bull;
              <a href="/register/recruiter" class="text-primary fw-semibold text-decoration-none">Recruiter Registration</a>
            </div>
          </div>
        </div>

        <!-- Quick Demo Credentials for Viva & Grading -->
        <div class="card border-0 bg-white shadow-sm mt-3">
          <div class="card-body p-3">
            <h6 class="fw-bold text-muted text-uppercase small mb-2">College Assignment Demo Credentials</h6>
            <div class="small">
              <div class="d-flex justify-content-between py-1 border-bottom">
                <span><strong>Admin:</strong> admin@placement.edu</span>
                <span class="text-muted font-monospace">Admin@123</span>
              </div>
              <div class="d-flex justify-content-between py-1 border-bottom">
                <span><strong>Student:</strong> student@placement.edu</span>
                <span class="text-muted font-monospace">Student@123</span>
              </div>
              <div class="d-flex justify-content-between py-1">
                <span><strong>Recruiter:</strong> recruiter@company.com</span>
                <span class="text-muted font-monospace">Recruiter@123</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <%- include('../partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
