<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Campus Placement & Internship Management System' %></title>
  <!-- Google Fonts Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Custom Portal CSS -->
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

  <%- include('partials/navbar') %>

  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container">
      <div class="d-inline-flex align-items-center gap-2 px-3 py-1 mb-3 rounded-pill bg-white border shadow-sm">
        <span class="badge bg-primary rounded-pill">Batch 2026</span>
        <span class="small text-muted font-monospace">Campus Recruitment Cycle Active</span>
      </div>
      <h1 class="hero-title">Your Career Journey Starts Here</h1>
      <p class="hero-subtitle">
        Discover campus placements, summer internships, and dream career opportunities tailored directly to your academic profile and skills.
      </p>
      <div class="d-flex justify-content-center gap-3 flex-wrap">
        <a href="/login?role=student" class="btn btn-primary btn-lg px-4 shadow-sm">Explore Opportunities</a>
        <a href="/login?role=student" class="btn btn-outline-primary btn-lg px-4 bg-white shadow-sm">Student Login</a>
      </div>
    </div>
  </section>

  <!-- Live Statistics Band -->
  <div class="container">
    <div class="hero-stats-band">
      <div class="row text-center g-4">
        <div class="col-6 col-md-3 border-end-md">
          <div class="stat-label">Active Drives</div>
          <div class="stat-val text-primary"><%= typeof stats !== 'undefined' ? stats.activeDrives : '12+' %></div>
          <div class="small text-muted mt-1">Placements & Internships</div>
        </div>
        <div class="col-6 col-md-3 border-end-md">
          <div class="stat-label">Companies Hiring</div>
          <div class="stat-val text-success"><%= typeof stats !== 'undefined' ? stats.companiesHiring : '25+' %></div>
          <div class="small text-muted mt-1">Top Tier Recruiters</div>
        </div>
        <div class="col-6 col-md-3 border-end-md">
          <div class="stat-label">Students Placed</div>
          <div class="stat-val text-info"><%= typeof stats !== 'undefined' ? stats.studentsPlaced : '180+' %></div>
          <div class="small text-muted mt-1">Offers Extended</div>
        </div>
        <div class="col-6 col-md-3">
          <div class="stat-label">Placement Rate</div>
          <div class="stat-val text-warning"><%= typeof stats !== 'undefined' ? stats.placementRate + '%' : '84.5%' %></div>
          <div class="small text-muted mt-1">Eligible Students Placed</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Featured Opportunities -->
  <section class="py-5">
    <div class="container">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h2 class="h4 fw-bold mb-1">Featured Campus Drives</h2>
          <p class="text-muted small mb-0">Actively accepting applications from eligible student batches</p>
        </div>
        <a href="/login?role=student" class="btn btn-outline-primary btn-sm">View All Drives &rarr;</a>
      </div>

      <div class="row g-3">
        <% if (typeof featuredDrives !== 'undefined' && featuredDrives.length > 0) { %>
          <% featuredDrives.forEach(drive => { %>
            <div class="col-md-6 col-lg-4">
              <div class="drive-card h-100 d-flex flex-column justify-content-between">
                <div>
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="drive-type-badge type-<%= drive.type.toLowerCase() %>"><%= drive.type %></span>
                    <span class="badge bg-light text-dark border"><%= drive.workMode %></span>
                  </div>
                  <h5 class="fw-bold mb-1 text-truncate" title="<%= drive.companyName %>"><%= drive.companyName %></h5>
                  <div class="text-primary fw-semibold small mb-2 text-truncate" title="<%= drive.role %>"><%= drive.role %></div>
                  <p class="text-muted small mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; min-height: 38px; line-height: 1.45;"><%= drive.description %></p>
                </div>
                <div>
                  <div class="d-flex flex-wrap gap-1 mb-3">
                    <span class="criteria-pill">Min CGPA: <strong><%= drive.minCGPA %></strong></span>
                    <span class="criteria-pill">Batch: <strong><%= drive.graduationYear %></strong></span>
                    <% if (drive.package) { %>
                      <span class="criteria-pill text-success fw-bold"><%= drive.package %></span>
                    <% } else if (drive.stipend) { %>
                      <span class="criteria-pill text-primary fw-bold"><%= drive.stipend %></span>
                    <% } %>
                  </div>
                  <a href="/login?role=student" class="btn btn-outline-primary btn-sm w-100">Check Eligibility & Apply</a>
                </div>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="col-12 text-center py-4">
            <p class="text-muted">No active drives available right now.</p>
          </div>
        <% } %>
      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section class="py-5 bg-white border-top border-bottom">
    <div class="container text-center">
      <h2 class="h3 fw-bold mb-2">How Campus Placements Work</h2>
      <p class="text-muted mb-5">Seamless four-step recruitment cycle from student registration to final selection</p>

      <div class="row g-4">
        <div class="col-md-3">
          <div class="p-3">
            <div class="stat-icon stat-icon-blue mx-auto mb-3">
              <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
            </div>
            <h5 class="fw-bold mb-2">1. Create Profile</h5>
            <p class="text-muted small">Update your roll number, CGPA, academic branch, backlogs count, verified resume, and tech skills.</p>
          </div>
        </div>

        <div class="col-md-3">
          <div class="p-3">
            <div class="stat-icon stat-icon-purple mx-auto mb-3">
              <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
            </div>
            <h5 class="fw-bold mb-2">2. Explore Opportunities</h5>
            <p class="text-muted small">Browse active placement and internship drives with automatic eligibility evaluation based on your credentials.</p>
          </div>
        </div>

        <div class="col-md-3">
          <div class="p-3">
            <div class="stat-icon stat-icon-amber mx-auto mb-3">
              <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <h5 class="fw-bold mb-2">3. Apply with 1-Click</h5>
            <p class="text-muted small">Submit verified applications before the deadline without duplicate forms or tedious paperwork.</p>
          </div>
        </div>

        <div class="col-md-3">
          <div class="p-3">
            <div class="stat-icon stat-icon-green mx-auto mb-3">
              <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
              </svg>
            </div>
            <h5 class="fw-bold mb-2">4. Track Selection</h5>
            <p class="text-muted small">Monitor your application status from Applied to Shortlisted, Interviewed, and Final Selection offer.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>

  <!-- Bootstrap 5 JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
