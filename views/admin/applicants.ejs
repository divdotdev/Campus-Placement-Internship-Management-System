<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Drive Applicants | Placement Cell' %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

  <%- include('../partials/navbar') %>

  <div class="portal-container">
    <% const activeTab = 'drives'; %>
    <%- include('../partials/adminSidebar', { activeTab }) %>

    <main class="portal-content">
      <%- include('../partials/alerts') %>

      <div class="mb-3">
        <a href="/admin/drives" class="text-decoration-none small text-muted">&larr; Back to all drives</a>
      </div>

      <!-- Drive Summary Banner -->
      <div class="portal-card mb-4">
        <div class="portal-card-body p-4">
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
              <div class="d-flex align-items-center gap-2 mb-1">
                <span class="drive-type-badge type-<%= drive.type.toLowerCase() %>"><%= drive.type %></span>
                <span class="badge <%= drive.status === 'Active' ? 'bg-success' : 'bg-secondary' %>"><%= drive.status %></span>
                <span class="small text-muted">&bull; Batch: <%= drive.graduationYear %></span>
              </div>
              <h3 class="fw-bold mb-1"><%= drive.companyName %> &mdash; <%= drive.role %></h3>
              <div class="small text-muted">
                Package: <strong class="text-success"><%= drive.package || drive.stipend || 'Competitive' %></strong> &bull;
                Location: <strong><%= drive.location %></strong> (<%= drive.workMode %>) &bull;
                Min CGPA: <strong><%= drive.minCGPA %></strong> &bull;
                Branches: <strong><%= drive.eligibleBranches.join(', ') %></strong>
              </div>
            </div>

            <!-- Auto Shortlist Eligible Applicants Button (Section 13) -->
            <div>
              <form action="/admin/drives/<%= drive._id %>/auto-shortlist" method="POST" class="auto-shortlist-form">
                <button type="submit" class="btn btn-warning btn-sm text-dark fw-semibold shadow-sm px-3">
                  <svg width="16" height="16" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                    <path d="M10.067.87a2.89 2.89 0 0 0-4.134 0l-.622.638-.89-.011a2.89 2.89 0 0 0-2.924 2.924l.01.89-.636.622a2.89 2.89 0 0 0 0 4.134l.637.622-.011.89a2.89 2.89 0 0 0 2.924 2.924l.89-.01.622.636a2.89 2.89 0 0 0 4.134 0l.622-.637.89.011a2.89 2.89 0 0 0 2.924-2.924l-.01-.89.636-.622a2.89 2.89 0 0 0 0-4.134l-.637-.622.011-.89a2.89 2.89 0 0 0-2.924-2.924l-.89.01-.622-.636zm.287 5.984-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7 8.793l2.646-2.647a.5.5 0 0 1 .708.708z"/>
                  </svg>
                  Auto Shortlist Eligible Applicants
                </button>
              </form>
              <div class="small text-muted text-end mt-1">Advances "Applied" &rarr; "Shortlisted"</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Stage Filter Pills & Eligibility Toggle -->
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div class="btn-group btn-group-sm flex-wrap" role="group">
          <a href="/admin/drives/<%= drive._id %>/applicants" class="btn <%= activeStatus === 'All' && !eligibleOnly ? 'btn-primary' : 'btn-outline-secondary' %>">
            All (<%= counts.all %>)
          </a>
          <a href="/admin/drives/<%= drive._id %>/applicants?status=Applied" class="btn <%= activeStatus === 'Applied' ? 'btn-primary' : 'btn-outline-secondary' %>">
            Applied (<%= counts.Applied %>)
          </a>
          <a href="/admin/drives/<%= drive._id %>/applicants?status=Shortlisted" class="btn <%= activeStatus === 'Shortlisted' ? 'btn-primary' : 'btn-outline-secondary' %>">
            Shortlisted (<%= counts.Shortlisted %>)
          </a>
          <a href="/admin/drives/<%= drive._id %>/applicants?status=Interviewed" class="btn <%= activeStatus === 'Interviewed' ? 'btn-primary' : 'btn-outline-secondary' %>">
            Interviewed (<%= counts.Interviewed %>)
          </a>
          <a href="/admin/drives/<%= drive._id %>/applicants?status=Selected" class="btn <%= activeStatus === 'Selected' ? 'btn-primary' : 'btn-outline-secondary' %>">
            Selected (<%= counts.Selected %>)
          </a>
          <a href="/admin/drives/<%= drive._id %>/applicants?status=Rejected" class="btn <%= activeStatus === 'Rejected' ? 'btn-primary' : 'btn-outline-secondary' %>">
            Rejected (<%= counts.Rejected %>)
          </a>
        </div>

        <div>
          <% if (eligibleOnly) { %>
            <a href="/admin/drives/<%= drive._id %>/applicants" class="btn btn-sm btn-success">
              &check; Showing Eligible Candidates Only (Click to Clear)
            </a>
          <% } else { %>
            <a href="/admin/drives/<%= drive._id %>/applicants?eligibleOnly=true" class="btn btn-sm btn-outline-success">
              Show Eligible Candidates Only
            </a>
          <% } %>
        </div>
      </div>

      <!-- Applicants Pipeline Table -->
      <div class="portal-card">
        <div class="table-responsive">
          <table class="table table-hover table-portal mb-0 align-middle">
            <thead>
              <tr>
                <th style="min-width: 170px;">Student</th>
                <th style="min-width: 85px;">Branch</th>
                <th style="min-width: 80px;">CGPA</th>
                <th style="min-width: 150px; max-width: 200px;">Skills</th>
                <th style="min-width: 110px;">Eligibility</th>
                <th style="min-width: 120px;">Current Status</th>
                <th class="text-end" style="min-width: 150px;">Update Stage</th>
              </tr>
            </thead>
            <tbody>
              <% if (applicants && applicants.length > 0) { %>
                <% applicants.forEach(app => { %>
                  <tr>
                    <td>
                      <div class="fw-bold text-truncate" style="max-width: 200px;"><%= app.student && app.student.user ? app.student.user.name : 'Student' %></div>
                      <div class="small text-muted font-monospace"><%= app.student ? app.student.rollNumber : '' %></div>
                      <% if (app.student && app.student.resumeUrl) { %>
                        <a href="<%= app.student.resumeUrl %>" target="_blank" rel="noopener noreferrer" class="small text-primary text-decoration-none d-inline-flex align-items-center gap-1 mt-1">
                          View Resume &nearr;
                        </a>
                      <% } %>
                    </td>
                    <td><span class="badge bg-light text-dark border"><%= app.student ? app.student.branch : 'CSE' %></span></td>
                    <td class="fw-bold <%= app.student && app.student.cgpa >= drive.minCGPA ? 'text-success' : 'text-danger' %>">
                      <%= app.student ? app.student.cgpa : 'N/A' %>
                    </td>
                    <td style="max-width: 200px;">
                      <% if (app.student && app.student.skills && app.student.skills.length > 0) { %>
                        <div class="d-flex flex-wrap gap-1">
                          <% app.student.skills.slice(0, 3).forEach(sk => { %>
                            <span class="badge bg-light text-dark border small text-truncate" style="max-width: 95px;"><%= sk %></span>
                          <% }) %>
                        </div>
                      <% } else { %>
                        <span class="text-muted small">None listed</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (app.eligibility.eligible) { %>
                        <span class="badge-eligible">&check; Eligible</span>
                      <% } else { %>
                        <span class="badge-ineligible" data-bs-toggle="tooltip" data-bs-placement="top" title="<%= app.eligibility.reasons.join(' | ') %>">
                          &cross; Ineligible
                        </span>
                      <% } %>
                    </td>
                    <td>
                      <span class="status-badge status-<%= app.status.toLowerCase() %>"><%= app.status %></span>
                    </td>
                    <td class="text-end">
                      <!-- Status Update Form -->
                      <form action="/admin/drives/<%= drive._id %>/applicants/status" method="POST" class="d-inline-flex gap-1 align-items-center justify-content-end">
                        <input type="hidden" name="applicationId" value="<%= app._id %>">
                        <select name="newStatus" class="form-select form-select-sm" style="width: 135px;" onchange="this.form.submit()">
                          <option value="Applied" <%= app.status === 'Applied' ? 'selected' : '' %>>Applied</option>
                          <option value="Shortlisted" <%= app.status === 'Shortlisted' ? 'selected' : '' %>>Shortlisted</option>
                          <option value="Interviewed" <%= app.status === 'Interviewed' ? 'selected' : '' %>>Interviewed</option>
                          <option value="Selected" <%= app.status === 'Selected' ? 'selected' : '' %>>Selected</option>
                          <option value="Rejected" <%= app.status === 'Rejected' ? 'selected' : '' %>>Rejected</option>
                        </select>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="text-center py-5 text-muted">
                    No applicants found matching this status filter.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <%- include('../partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
