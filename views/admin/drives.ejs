<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Manage Drives | Placement Cell' %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

  <%- include('../partials/navbar') %>

  <div class="portal-container">
    <% const activeTab = 'drives'; %>
    <%- include('../partials/adminSidebar', { activeTab }) %>

    <main class="portal-content">
      <%- include('../partials/alerts') %>

      <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
          <h2 class="h4 fw-bold mb-1">Placement &amp; Internship Drives</h2>
          <p class="text-muted small mb-0">Create and oversee recruitment drives, eligibility rules, and applicant pipelines</p>
        </div>
        <a href="/admin/drives/create" class="btn btn-primary btn-sm px-3 shadow-sm">+ Create Drive</a>
      </div>

      <div class="portal-card">
        <div class="table-responsive">
          <table class="table table-hover table-portal mb-0 align-middle">
            <thead>
              <tr>
                <th style="min-width: 140px;">Company</th>
                <th style="min-width: 170px;">Role</th>
                <th style="min-width: 90px;">Type</th>
                <th style="min-width: 120px;">Package / Stipend</th>
                <th style="min-width: 120px;">Applications</th>
                <th style="min-width: 80px;">Min CGPA</th>
                <th style="min-width: 110px;">Deadline</th>
                <th style="min-width: 90px;">Status</th>
                <th class="text-end" style="min-width: 150px;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (drives && drives.length > 0) { %>
                <% drives.forEach(drive => { %>
                  <tr>
                    <td class="fw-bold"><%= drive.companyName %></td>
                    <td>
                      <div class="fw-semibold"><%= drive.role %></div>
                      <div class="small text-muted"><%= drive.location %> &bull; <%= drive.workMode %></div>
                    </td>
                    <td>
                      <span class="drive-type-badge type-<%= drive.type.toLowerCase() %>"><%= drive.type %></span>
                    </td>
                    <td class="fw-bold text-success">
                      <%= drive.package || drive.stipend || 'Competitive' %>
                    </td>
                    <td>
                      <a href="/admin/drives/<%= drive._id %>/applicants" class="badge bg-primary text-white text-decoration-none px-2 py-1">
                        <%= drive.applicantCount %> Applicants &rarr;
                      </a>
                    </td>
                    <td><span class="criteria-pill"><%= drive.minCGPA %></span></td>
                    <td class="small <%= new Date(drive.applicationDeadline) < new Date() ? 'text-danger fw-bold' : 'text-muted' %>">
                      <%= new Date(drive.applicationDeadline).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                    </td>
                    <td>
                      <span class="badge <%= drive.status === 'Active' ? 'bg-success-subtle text-success border-success' : 'bg-secondary-subtle text-secondary' %> border px-2 py-1">
                        <%= drive.status %>
                      </span>
                    </td>
                    <td class="text-end">
                      <div class="d-inline-flex gap-1">
                        <a href="/admin/drives/<%= drive._id %>/applicants" class="btn btn-sm btn-outline-primary" title="Review Applicants">
                          Applicants
                        </a>
                        <a href="/admin/drives/<%= drive._id %>/edit" class="btn btn-sm btn-outline-secondary" title="Edit Drive">
                          Edit
                        </a>
                        <form action="/admin/drives/<%= drive._id %>/delete" method="POST" class="d-inline confirm-delete-form" data-confirm-message="Are you sure you want to delete the drive for <%= drive.companyName %>? All applicant data for this drive will be deleted.">
                          <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Drive">
                            &times;
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="9" class="text-center py-5 text-muted">
                    No recruitment drives created yet. Click "+ Create Drive" to publish the first opportunity.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <%- include('../partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
