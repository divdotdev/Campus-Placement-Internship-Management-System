<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Student Directory | Placement Cell' %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

  <%- include('../partials/navbar') %>

  <div class="portal-container">
    <% const activeTab = 'students'; %>
    <%- include('../partials/adminSidebar', { activeTab }) %>

    <main class="portal-content">
      <%- include('../partials/alerts') %>

      <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
          <h2 class="h4 fw-bold mb-1">Registered Students Directory</h2>
          <p class="text-muted small mb-0">Search, inspect academic credentials, and verify placement status across batches</p>
        </div>
        <span class="badge bg-light text-dark border p-2">Total Listed: <%= students ? students.length : 0 %></span>
      </div>

      <!-- Filters Bar -->
      <div class="portal-card mb-4">
        <div class="portal-card-body p-3">
          <form action="/admin/students" method="GET" class="row g-2 align-items-center">
            <div class="col-md-4">
              <input type="text" class="form-control form-control-sm" name="search" placeholder="Search by student name or roll no..." value="<%= filters.search %>">
            </div>
            <div class="col-6 col-md-3">
              <select class="form-select form-select-sm" name="branch">
                <option value="All" <%= filters.branch === 'All' ? 'selected' : '' %>>All Branches</option>
                <% ['CSE', 'IT', 'AIML', 'ECE', 'EE', 'MECH', 'CIVIL', 'OTHER'].forEach(b => { %>
                  <option value="<%= b %>" <%= filters.branch === b ? 'selected' : '' %>><%= b %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-6 col-md-3">
              <select class="form-select form-select-sm" name="placementStatus">
                <option value="all" <%= filters.placementStatus === 'all' ? 'selected' : '' %>>All Placement Statuses</option>
                <option value="placed" <%= filters.placementStatus === 'placed' ? 'selected' : '' %>>Placed Only</option>
                <option value="unplaced" <%= filters.placementStatus === 'unplaced' ? 'selected' : '' %>>Unplaced Only</option>
              </select>
            </div>
            <div class="col-12 col-md-2 d-flex gap-1">
              <button type="submit" class="btn btn-primary btn-sm w-100">Filter</button>
              <a href="/admin/students" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
          </form>
        </div>
      </div>

      <!-- Students Table -->
      <div class="portal-card">
        <div class="table-responsive">
          <table class="table table-hover table-portal mb-0 align-middle">
            <thead>
              <tr>
                <th style="min-width: 120px;">Roll Number</th>
                <th style="min-width: 160px;">Student Name</th>
                <th style="min-width: 80px;">Branch</th>
                <th style="min-width: 80px;">Semester</th>
                <th style="min-width: 75px;">CGPA</th>
                <th style="min-width: 80px;">Backlogs</th>
                <th style="min-width: 180px;">Placement Standing</th>
                <th style="min-width: 100px;">Resume</th>
              </tr>
            </thead>
            <tbody>
              <% if (students && students.length > 0) { %>
                <% students.forEach(student => { %>
                  <tr>
                    <td class="fw-bold font-monospace"><%= student.rollNumber %></td>
                    <td>
                      <div class="fw-semibold"><%= student.user ? student.user.name : 'Unknown' %></div>
                      <div class="small text-muted"><%= student.user ? student.user.email : '' %></div>
                    </td>
                    <td><span class="badge bg-light text-dark border"><%= student.branch %></span></td>
                    <td class="small">Sem <%= student.semester %></td>
                    <td class="fw-bold <%= student.cgpa >= 7.5 ? 'text-success' : (student.cgpa >= 6.0 ? 'text-primary' : 'text-danger') %>">
                      <%= student.cgpa %>
                    </td>
                    <td class="small <%= student.activeBacklogs > 0 ? 'text-danger fw-bold' : 'text-muted' %>">
                      <%= student.activeBacklogs %>
                    </td>
                    <td>
                      <% if (student.isPlaced) { %>
                        <span class="badge bg-success-subtle text-success border border-success">
                          Placed &bull; <%= student.placedCompany %>
                        </span>
                        <div class="small text-muted mt-1"><%= student.placedRole %> (<%= student.placedPackage || 'Offer' %>)</div>
                      <% } else { %>
                        <span class="badge bg-secondary-subtle text-secondary border">Unplaced</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (student.resumeUrl) { %>
                        <a href="<%= student.resumeUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary py-1 px-2 small">
                          Resume &nearr;
                        </a>
                      <% } else { %>
                        <span class="text-muted small">Not provided</span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="8" class="text-center py-4 text-muted">No students found matching current filters.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <%- include('../partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
