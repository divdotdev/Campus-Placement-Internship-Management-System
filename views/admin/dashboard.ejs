<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Admin Dashboard | Placement Cell' %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Chart.js for Visualization -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

  <%- include('../partials/navbar') %>

  <div class="portal-container">
    <% const activeTab = 'dashboard'; %>
    <%- include('../partials/adminSidebar', { activeTab }) %>

    <main class="portal-content">
      <%- include('../partials/alerts') %>

      <!-- Top Header -->
      <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
          <h2 class="h4 fw-bold mb-1">Placement Cell Administration</h2>
          <p class="text-muted small mb-0">Overview of campus drives, student statistics, and recruitment analytics</p>
        </div>
        <div class="d-flex gap-2 mt-2 mt-sm-0">
          <a href="/admin/drives/create" class="btn btn-primary btn-sm">+ Create New Drive</a>
          <a href="/admin/students" class="btn btn-outline-secondary btn-sm">View Students</a>
        </div>
      </div>

      <!-- Dashboard Statistics Cards (6 Cards) -->
      <div class="row g-3 mb-4">
        <div class="col-6 col-sm-4 col-xl-2">
          <div class="stat-card">
            <div class="stat-label">Total Students</div>
            <div class="stat-val text-primary"><%= stats.totalStudents %></div>
            <div class="stat-sub text-muted">Registered Pool</div>
          </div>
        </div>
        <div class="col-6 col-sm-4 col-xl-2">
          <div class="stat-card">
            <div class="stat-label">Active Drives</div>
            <div class="stat-val text-success"><%= stats.activeDrives %></div>
            <div class="stat-sub text-muted">Open for Apply</div>
          </div>
        </div>
        <div class="col-6 col-sm-4 col-xl-2">
          <div class="stat-card">
            <div class="stat-label">Applications</div>
            <div class="stat-val text-info"><%= stats.totalApplications %></div>
            <div class="stat-sub text-muted">Total Pipeline</div>
          </div>
        </div>
        <div class="col-6 col-sm-4 col-xl-2">
          <div class="stat-card">
            <div class="stat-label">Placed</div>
            <div class="stat-val text-success"><%= stats.placedStudents %></div>
            <div class="stat-sub text-muted">Offers Accepted</div>
          </div>
        </div>
        <div class="col-6 col-sm-4 col-xl-2">
          <div class="stat-card">
            <div class="stat-label">Unplaced</div>
            <div class="stat-val text-muted"><%= stats.unplacedStudents %></div>
            <div class="stat-sub text-muted">Active Seekers</div>
          </div>
        </div>
        <div class="col-6 col-sm-4 col-xl-2">
          <div class="stat-card">
            <div class="stat-label">Placement %</div>
            <div class="stat-val text-warning"><%= stats.placementRate %>%</div>
            <div class="stat-sub text-muted">Success Ratio</div>
          </div>
        </div>
      </div>

      <!-- Charts Row: Branch-wise and Company-wise -->
      <div class="row g-4 mb-4">
        <div class="col-lg-7">
          <div class="portal-card h-100">
            <div class="portal-card-header">
              <h5 class="portal-card-title">Branch-wise Placement Statistics</h5>
              <span class="small text-muted">Total vs Placed</span>
            </div>
            <div class="portal-card-body p-3">
              <div class="chart-container-box">
                <canvas id="branchChart"></canvas>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-5">
          <div class="portal-card h-100">
            <div class="portal-card-header">
              <h5 class="portal-card-title">Company Selections Breakdown</h5>
              <span class="small text-muted">Top Recruiters</span>
            </div>
            <div class="portal-card-body p-3">
              <div class="chart-container-box">
                <canvas id="companyChart"></canvas>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Recent Tables: Recent Drives & Recent Applications -->
      <div class="row g-4">
        <!-- Recent Drives -->
        <div class="col-lg-6">
          <div class="portal-card h-100">
            <div class="portal-card-header">
              <h5 class="portal-card-title">Active & Recent Drives</h5>
              <a href="/admin/drives" class="small text-primary text-decoration-none fw-semibold">View All &rarr;</a>
            </div>
            <div class="table-responsive">
              <table class="table table-hover table-portal mb-0">
                <thead>
                  <tr>
                    <th>Company</th>
                    <th>Role</th>
                    <th>Type</th>
                    <th>Deadline</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (recentDrives && recentDrives.length > 0) { %>
                    <% recentDrives.forEach(drive => { %>
                      <tr>
                        <td class="fw-bold"><%= drive.companyName %></td>
                        <td><%= drive.role %></td>
                        <td><span class="drive-type-badge type-<%= drive.type.toLowerCase() %>"><%= drive.type %></span></td>
                        <td class="small text-muted"><%= new Date(drive.applicationDeadline).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %></td>
                        <td>
                          <span class="badge <%= drive.status === 'Active' ? 'bg-success-subtle text-success border-success' : 'bg-secondary-subtle text-secondary' %> border px-2 py-1">
                            <%= drive.status %>
                          </span>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr><td colspan="5" class="text-center py-3 text-muted">No drives posted yet.</td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Recent Applications -->
        <div class="col-lg-6">
          <div class="portal-card h-100">
            <div class="portal-card-header">
              <h5 class="portal-card-title">Recent Applicant Submissions</h5>
              <span class="small text-muted">Real-Time Pipeline</span>
            </div>
            <div class="table-responsive">
              <table class="table table-hover table-portal mb-0">
                <thead>
                  <tr>
                    <th>Student</th>
                    <th>Company</th>
                    <th>Branch</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (recentApplications && recentApplications.length > 0) { %>
                    <% recentApplications.forEach(app => { %>
                      <tr>
                        <td class="fw-bold"><%= app.student && app.student.user ? app.student.user.name : 'Student' %></td>
                        <td><%= app.companyName %></td>
                        <td class="small"><%= app.student ? app.student.branch : 'CSE' %></td>
                        <td>
                          <span class="status-badge status-<%= app.status.toLowerCase() %>"><%= app.status %></span>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr><td colspan="4" class="text-center py-3 text-muted">No applications received yet.</td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <%- include('../partials/footer') %>

  <!-- Chart.js Setup Script -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Branch Stats Chart
      const branchData = <%- JSON.stringify(branchStats) %>;
      const branchLabels = branchData.map(b => b._id);
      const branchTotal = branchData.map(b => b.total);
      const branchPlaced = branchData.map(b => b.placed);

      const ctxBranch = document.getElementById('branchChart');
      if (ctxBranch) {
        new Chart(ctxBranch, {
          type: 'bar',
          data: {
            labels: branchLabels.length > 0 ? branchLabels : ['CSE', 'IT', 'AIML', 'ECE'],
            datasets: [
              {
                label: 'Total Students',
                data: branchTotal.length > 0 ? branchTotal : [80, 60, 50, 45],
                backgroundColor: '#cbd5e1',
                borderRadius: 4
              },
              {
                label: 'Placed Students',
                data: branchPlaced.length > 0 ? branchPlaced : [55, 42, 38, 26],
                backgroundColor: '#1e3a8a',
                borderRadius: 4
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { position: 'top' }
            },
            scales: {
              y: { beginAtZero: true }
            }
          }
        });
      }

      // 2. Company Selections Chart
      const companyData = <%- JSON.stringify(companyStats) %>;
      const companyLabels = companyData.map(c => c._id);
      const companySelections = companyData.map(c => c.selections);

      const ctxCompany = document.getElementById('companyChart');
      if (ctxCompany) {
        new Chart(ctxCompany, {
          type: 'doughnut',
          data: {
            labels: companyLabels.length > 0 ? companyLabels : ['Google', 'Microsoft', 'TCS', 'Infosys', 'Accenture'],
            datasets: [{
              data: companySelections.length > 0 ? companySelections : [5, 6, 12, 10, 8],
              backgroundColor: ['#2563eb', '#0284c7', '#16a34a', '#d97706', '#7c3aed', '#dc2626']
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { position: 'bottom' }
            }
          }
        });
      }
    });
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
