<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Edit Drive | Placement Cell' %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

  <%- include('../partials/navbar') %>

  <div class="portal-container">
    <% const activeTab = 'drives'; %>
    <%- include('../partials/adminSidebar', { activeTab }) %>

    <main class="portal-content">
      <%- include('../partials/alerts') %>

      <div class="mb-3">
        <a href="/admin/drives" class="text-decoration-none small text-muted">&larr; Back to all drives</a>
      </div>

      <div class="portal-card">
        <div class="portal-card-header">
          <h4 class="portal-card-title">Edit Drive: <%= drive.companyName %> - <%= drive.role %></h4>
        </div>
        <div class="portal-card-body p-4">
          <form action="/admin/drives/<%= drive._id %>/edit" method="POST">
            <!-- Section 1: Company & Job Role -->
            <h5 class="fw-bold text-primary border-bottom pb-2 mb-3">1. Company &amp; Role Details</h5>
            <div class="row g-3 mb-4">
              <div class="col-md-6">
                <label for="companyName" class="form-label">Company Name <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="companyName" name="companyName" required value="<%= drive.companyName %>">
              </div>
              <div class="col-md-6">
                <label for="companyWebsite" class="form-label">Company Website</label>
                <input type="url" class="form-control" id="companyWebsite" name="companyWebsite" value="<%= drive.companyWebsite || '' %>">
              </div>
              <div class="col-md-4">
                <label for="driveTypeSelect" class="form-label">Drive Type <span class="text-danger">*</span></label>
                <select class="form-select" id="driveTypeSelect" name="type" required>
                  <option value="Placement" <%= drive.type === 'Placement' ? 'selected' : '' %>>Placement (Full-Time)</option>
                  <option value="Internship" <%= drive.type === 'Internship' ? 'selected' : '' %>>Internship (Summer/Winter)</option>
                </select>
              </div>
              <div class="col-md-4">
                <label for="role" class="form-label">Job Role / Title <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="role" name="role" required value="<%= drive.role %>">
              </div>
              <div class="col-md-4">
                <label for="workMode" class="form-label">Work Mode <span class="text-danger">*</span></label>
                <select class="form-select" id="workMode" name="workMode" required>
                  <option value="On-site" <%= drive.workMode === 'On-site' ? 'selected' : '' %>>On-site</option>
                  <option value="Hybrid" <%= drive.workMode === 'Hybrid' ? 'selected' : '' %>>Hybrid</option>
                  <option value="Remote" <%= drive.workMode === 'Remote' ? 'selected' : '' %>>Remote</option>
                </select>
              </div>
              <div class="col-md-4" id="packageContainer">
                <label for="package" class="form-label">Annual Package (CTC)</label>
                <input type="text" class="form-control" id="package" name="package" value="<%= drive.package || '' %>">
              </div>
              <div class="col-md-4" id="stipendContainer" style="display: none;">
                <label for="stipend" class="form-label">Monthly Stipend</label>
                <input type="text" class="form-control" id="stipend" name="stipend" value="<%= drive.stipend || '' %>">
              </div>
              <div class="col-md-4">
                <label for="location" class="form-label">Location <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="location" name="location" required value="<%= drive.location %>">
              </div>
              <div class="col-md-4">
                <label for="openings" class="form-label">Number of Openings</label>
                <input type="number" min="1" class="form-control" id="openings" name="openings" value="<%= drive.openings %>">
              </div>
              <div class="col-md-12">
                <label for="description" class="form-label">Job Description &amp; Requirements <span class="text-danger">*</span></label>
                <textarea class="form-control" id="description" name="description" rows="4" required><%= drive.description %></textarea>
              </div>
            </div>

            <!-- Section 2: Eligibility Criteria -->
            <h5 class="fw-bold text-primary border-bottom pb-2 mb-3">2. Automatic Eligibility Rules</h5>
            <div class="row g-3 mb-4">
              <div class="col-md-4">
                <label for="minCGPA" class="form-label">Minimum CGPA (0 - 10) <span class="text-danger">*</span></label>
                <input type="number" step="0.1" min="0" max="10" class="form-control" id="minCGPA" name="minCGPA" required value="<%= drive.minCGPA %>">
              </div>
              <div class="col-md-4">
                <label for="graduationYear" class="form-label">Eligible Batch (Graduation Year) <span class="text-danger">*</span></label>
                <select class="form-select" id="graduationYear" name="graduationYear" required>
                  <% [2025, 2026, 2027, 2028].forEach(yr => { %>
                    <option value="<%= yr %>" <%= drive.graduationYear === yr ? 'selected' : '' %>><%= yr %> Batch</option>
                  <% }) %>
                </select>
              </div>
              <div class="col-md-4">
                <label for="maxBacklogs" class="form-label">Max Active Backlogs Permitted <span class="text-danger">*</span></label>
                <input type="number" min="0" class="form-control" id="maxBacklogs" name="maxBacklogs" required value="<%= drive.maxBacklogs %>">
              </div>
              <div class="col-md-6">
                <label class="form-label">Eligible Academic Branches <span class="text-danger">*</span></label>
                <div class="d-flex flex-wrap gap-2 pt-1">
                  <% ['CSE', 'IT', 'AIML', 'ECE', 'EE', 'MECH', 'CIVIL', 'ALL'].forEach(br => { %>
                    <div class="form-check form-check-inline">
                      <input class="form-check-input" type="checkbox" name="eligibleBranches" id="edit_branch_<%= br %>" value="<%= br %>" <%= drive.eligibleBranches && drive.eligibleBranches.includes(br) ? 'checked' : '' %>>
                      <label class="form-check-label small" for="edit_branch_<%= br %>"><%= br %></label>
                    </div>
                  <% }) %>
                </div>
              </div>
              <div class="col-md-6">
                <label for="requiredSkills" class="form-label">Required Skills (comma separated)</label>
                <input type="text" class="form-control" id="requiredSkills" name="requiredSkills" value="<%= drive.requiredSkills ? drive.requiredSkills.join(', ') : '' %>">
              </div>
            </div>

            <!-- Section 3: Timeline & Drive Status -->
            <h5 class="fw-bold text-primary border-bottom pb-2 mb-3">3. Timeline &amp; Drive Status</h5>
            <div class="row g-3 mb-4">
              <div class="col-md-4">
                <label for="applicationDeadline" class="form-label">Application Deadline Date <span class="text-danger">*</span></label>
                <input type="date" class="form-control" id="applicationDeadline" name="applicationDeadline" required value="<%= drive.applicationDeadline ? new Date(drive.applicationDeadline).toISOString().split('T')[0] : '' %>">
              </div>
              <div class="col-md-4">
                <label for="driveDate" class="form-label">Drive / Assessment Date</label>
                <input type="date" class="form-control" id="driveDate" name="driveDate" value="<%= drive.driveDate ? new Date(drive.driveDate).toISOString().split('T')[0] : '' %>">
              </div>
              <div class="col-md-4">
                <label for="status" class="form-label">Drive Status <span class="text-danger">*</span></label>
                <select class="form-select" id="status" name="status" required>
                  <option value="Active" <%= drive.status === 'Active' ? 'selected' : '' %>>Active (Open for applications)</option>
                  <option value="Closed" <%= drive.status === 'Closed' ? 'selected' : '' %>>Closed (Applications disabled)</option>
                </select>
              </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
              <a href="/admin/drives" class="btn btn-outline-secondary">Cancel</a>
              <button type="submit" class="btn btn-primary px-4">Update Recruitment Drive</button>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>

  <%- include('../partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
