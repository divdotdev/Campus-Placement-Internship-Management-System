<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Student Dashboard | Placement Portal' %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

  <%- include('../partials/navbar') %>

  <div class="portal-container">
    <% const activeTab = 'dashboard'; %>
    <%- include('../partials/studentSidebar', { activeTab }) %>

    <main class="portal-content">
      <%- include('../partials/alerts') %>

      <!-- Top Student Welcome Header -->
      <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
          <h2 class="h4 fw-bold mb-1">Welcome, <%= currentUser.name %>!</h2>
          <p class="text-muted small mb-0">
            <%= profile.branch %> &bull; Roll No: <%= profile.rollNumber %> &bull; CGPA: <%= profile.cgpa %> &bull; Batch: <%= profile.graduationYear %>
          </p>
        </div>
        <div class="mt-2 mt-sm-0">
          <a href="/student/profile" class="btn btn-outline-primary btn-sm">Edit Profile</a>
        </div>
      </div>

      <!-- Placement Policy Notice if Placed -->
      <% if (profile.isPlaced) { %>
        <div class="alert alert-success d-flex align-items-center mb-4 shadow-sm border-success" role="alert">
          <svg class="bi flex-shrink-0 me-3" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
          </svg>
          <div>
            <h5 class="alert-heading fw-bold mb-1">Congratulations! You are officially Placed!</h5>
            <p class="mb-1 small">
              You have accepted an offer from <strong><%= profile.placedCompany %></strong> for the role of <strong><%= profile.placedRole %></strong> (<%= profile.placedPackage || 'Competitive CTC' %>).
            </p>
            <span class="badge bg-light text-success border">Campus Placement Policy Active: 1-Offer Limit</span>
          </div>
        </div>
      <% } %>

      <!-- Profile Completeness Widget -->
      <div class="portal-card mb-4">
        <div class="portal-card-body p-3">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="small fw-bold text-muted text-uppercase">Profile Completeness: <%= completeness.percentage %>%</span>
            <% if (completeness.percentage < 100) { %>
              <a href="/student/profile" class="small text-primary fw-semibold text-decoration-none">Complete Remaining Details &rarr;</a>
            <% } else { %>
              <span class="badge bg-success">100% Completed</span>
            <% } %>
          </div>
          <div class="progress" style="height: 8px;">
            <div class="progress-bar bg-primary" role="progressbar" style="width: <%= completeness.percentage %>%;" aria-valuenow="<%= completeness.percentage %>" aria-valuemin="0" aria-valuemax="100"></div>
          </div>
          <% if (completeness.missingFields.length > 0) { %>
            <div class="small text-muted mt-2">
              Recommended to add: <%= completeness.missingFields.slice(0, 3).join(', ') %>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Dashboard Metric Cards -->
      <div class="row g-3 mb-4">
        <div class="col-6 col-lg">
          <div class="stat-card">
            <div class="stat-label">Available Drives</div>
            <div class="stat-val text-primary"><%= stats.availableDrives %></div>
            <div class="small text-muted mt-1">Open on Portal</div>
          </div>
        </div>
        <div class="col-6 col-lg">
          <div class="stat-card">
            <div class="stat-label">Eligible Drives</div>
            <div class="stat-val text-success"><%= stats.eligibleDrives %></div>
            <div class="small text-muted mt-1">Matched to Profile</div>
          </div>
        </div>
        <div class="col-6 col-lg">
          <div class="stat-card">
            <div class="stat-label">Applications</div>
            <div class="stat-val text-info"><%= stats.applicationsSubmitted %></div>
            <div class="small text-muted mt-1">Submitted</div>
          </div>
        </div>
        <div class="col-6 col-lg">
          <div class="stat-card">
            <div class="stat-label">Interviews</div>
            <div class="stat-val text-purple" style="color: #7c3aed;"><%= stats.interviews %></div>
            <div class="small text-muted mt-1">Scheduled</div>
          </div>
        </div>
        <div class="col-6 col-lg">
          <div class="stat-card">
            <div class="stat-label">Selections</div>
            <div class="stat-val text-warning"><%= stats.selected %></div>
            <div class="small text-muted mt-1">Job Offers</div>
          </div>
        </div>
      </div>

      <!-- Main Columns: Recommended Opportunities & Recent Statuses -->
      <div class="row g-4">
        <!-- Recommended Opportunities (Eligible Drives) -->
        <div class="col-lg-7">
          <div class="portal-card h-100">
            <div class="portal-card-header">
              <h5 class="portal-card-title">Recommended Opportunities</h5>
              <a href="/student/drives" class="small text-primary text-decoration-none fw-semibold">View All &rarr;</a>
            </div>
            <div class="portal-card-body p-3">
              <% if (recommendedDrives && recommendedDrives.length > 0) { %>
                <div class="d-flex flex-column gap-3">
                  <% recommendedDrives.forEach(drive => { %>
                    <div class="border rounded p-3 bg-white shadow-xs">
                      <div class="d-flex justify-content-between align-items-start mb-1">
                        <div>
                          <span class="drive-type-badge type-<%= drive.type.toLowerCase() %> me-2"><%= drive.type %></span>
                          <span class="badge-eligible"><%= drive.type === 'Internship' ? 'Eligible' : 'Eligible for Placement' %></span>
                        </div>
                        <span class="small text-muted">Deadline: <%= new Date(drive.applicationDeadline).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %></span>
                      </div>
                      <h6 class="fw-bold mb-1"><%= drive.companyName %> &bull; <span class="text-primary"><%= drive.role %></span></h6>
                      <div class="small text-muted mb-2">
                        Location: <%= drive.location %> (<%= drive.workMode %>) &bull;
                        CTC: <strong><%= drive.package || drive.stipend || 'Competitive' %></strong>
                      </div>
                      <div class="d-flex justify-content-between align-items-center">
                        <span class="criteria-pill">Min CGPA: <%= drive.minCGPA %></span>
                        <a href="/student/drives/<%= drive._id %>" class="btn btn-sm btn-primary">Check & Apply</a>
                      </div>
                    </div>
                  <% }) %>
                </div>
              <% } else { %>
                <div class="text-center py-4 text-muted">
                  <p class="mb-1">No currently eligible drives found matching your academic branch and CGPA.</p>
                  <a href="/student/drives" class="btn btn-sm btn-outline-secondary mt-2">Browse All Drives</a>
                </div>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Latest Application Statuses -->
        <div class="col-lg-5">
          <div class="portal-card h-100">
            <div class="portal-card-header">
              <h5 class="portal-card-title">Latest Application Statuses</h5>
              <a href="/student/applications" class="small text-primary text-decoration-none fw-semibold">Track All &rarr;</a>
            </div>
            <div class="portal-card-body p-3">
              <% if (recentApplications && recentApplications.length > 0) { %>
                <div class="list-group list-group-flush">
                  <% recentApplications.forEach(app => { %>
                    <div class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center">
                      <div>
                        <div class="fw-bold"><%= app.companyName %></div>
                        <div class="small text-muted"><%= app.drive ? app.drive.role : 'Campus Drive' %></div>
                        <div class="small text-muted">Applied: <%= new Date(app.applicationDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %></div>
                      </div>
                      <div>
                        <span class="status-badge status-<%= app.status.toLowerCase() %>"><%= app.status %></span>
                      </div>
                    </div>
                  <% }) %>
                </div>
              <% } else { %>
                <div class="text-center py-4 text-muted">
                  <p class="mb-1">You haven't applied to any drives yet.</p>
                  <a href="/student/drives" class="btn btn-sm btn-outline-primary mt-2">Explore Drives Now</a>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <%- include('../partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
